{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bento",
  "version": "0.1.0",
  "identifier": "com.blustardave.bento",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bento",
        "width": 1240,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A minimal, fast CSV editor",
    "fileAssociations": [
      { "ext": ["csv"], "name": "CSV file", "description": "Comma-separated values", "role": "Editor" },
      { "ext": ["tsv"], "name": "TSV file", "description": "Tab-separated values", "role": "Editor" }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
